<mapper namespace="com.example.mapper.UserMapper">

    <!-- 사용자 조회 SQL -->
    <select id="findUserById" resultType="com.example.domain.User">
        SELECT id, name, email
        FROM users
        WHERE id = #{id}
    </select>

    <!-- 모든 사용자 조회 SQL -->
    <select id="findAllUsers" resultType="com.example.domain.User">
        SELECT id, name, email
        FROM users
    </select>

</mapper>